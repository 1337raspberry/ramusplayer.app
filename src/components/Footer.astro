---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import { REPO_URL } from "../lib/release";
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <Image src={logo} alt="" width={64} height={64} class="footer__mark" />
      <p>i made ramus for myself. you can use it too if you want. <span class="footer__sig">· <a href="https://github.com/1337raspberry">1337raspberry</a></span></p>
    </div>
    <div class="footer__fine">
      <p>
        ramus is an independent third-party client. it is not affiliated with, endorsed by or sponsored by
        Plex. <a href="/support/">support</a> · <a href="/privacy/">privacy policy</a> · <a
          href="/credits/">demo music credits</a>.
      </p>
      <p>
        the source is <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT licensed</a>. some builds bundle GPL libraries and
        ship as GPL-3.0-or-later; <a href={`${REPO_URL}/blob/main/ramus-tauri/licenses/NOTICE.md`}>NOTICE.md</a> has the
        details. the default genre tree is derived from <a href="https://github.com/beetbox/beets">beets</a>, and lyrics
        come from <a href="https://lrclib.net/">lrclib</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 3.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem 4rem;
  }

  .footer__brand {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: var(--ink-2);
  }

  .footer__mark {
    flex: none;
    width: 32px;
    height: 32px;
  }

  .footer__fine {
    display: grid;
    gap: 0.75rem;
    color: var(--ink-3);
    font-size: 0.85rem;
  }

  .footer a {
    color: var(--ink-2);
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
