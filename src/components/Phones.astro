---
import { Picture } from "astro:assets";
import library from "../assets/shots/mobile-library.webp";
import nowPlaying from "../assets/shots/mobile-np.webp";
import lyrics from "../assets/shots/mobile-lyrics.webp";
import widgets from "../assets/shots/mobile-widgets.webp";

const phones = [
  { src: library, alt: "ramus on iPhone: the genre tree open at Hardcore Punk › Post-Hardcore › Emo, with AFI playing in the mini player." },
  { src: nowPlaying, alt: "ramus on iPhone: the now playing screen with album art and a waveform scrubber." },
  { src: lyrics, alt: "ramus on iPhone: synced lyrics for Phoebe Bridgers' Graceland Too, the current line in red above the waveform and playback controls." },
  { src: widgets, alt: "ramus on an iPhone home screen: medium and large now playing widgets for AFI's The Lost Souls, each with album art, a waveform and playback controls." },
];
---

<section class="section phones" data-tint="#323442 #21292a">
  <div class="wrap phones__copy">
    <h2 class="headline">
      hella platforms supported
    </h2>
    <p class="lede">
      macOS, windows, linux, iOS and android. being honest tho prolly focus the most on ios tbh
    </p>
  </div>
  <div class="wrap phones__row">
    {
      phones.map((p, i) => (
        <div class="phones__item rise" style={`--i: ${i}`}>
          <Picture
            src={p.src}
            formats={["avif", "webp"]}
            widths={[300, 460, 700]}
            sizes="(min-width: 1120px) 280px, (min-width: 641px) 23vw, 42vw"
            alt={p.alt}
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .phones__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .phones__copy .headline {
    max-width: 20ch;
  }

  .phones__row {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* A fan of four. The offsets live on transform because the scroll-driven
     rise animates translate, which would otherwise replace them. */
  .phones__item {
    width: min(25%, 280px);
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.5));
  }

  .phones__item:nth-child(1) {
    rotate: -7deg;
    transform: translate(10%, 9%);
  }

  .phones__item:nth-child(2) {
    z-index: 1;
    rotate: -2deg;
    transform: translate(3%, 0);
  }

  .phones__item:nth-child(3) {
    z-index: 1;
    rotate: 2deg;
    transform: translate(-3%, 0);
  }

  .phones__item:nth-child(4) {
    rotate: 7deg;
    transform: translate(-10%, 9%);
  }

  /* Two by two, each pair leaning in. */
  @media (max-width: 640px) {
    .phones__row {
      flex-wrap: wrap;
      row-gap: 1.5rem;
    }
    .phones__item {
      width: 46%;
    }
    .phones__item:nth-child(odd) {
      z-index: 0;
      rotate: -4deg;
      transform: translate(5%, 3%);
    }
    .phones__item:nth-child(even) {
      z-index: 1;
      rotate: 4deg;
      transform: translate(-5%, 3%);
    }
  }
</style>
